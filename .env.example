# Copy this file to .env and fill in a unique value.
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Wrap the value in single quotes so characters like $ and ! are read literally.
SECRET_KEY=''

# Optional. Where the Ollama server lives; defaults to a local one. Only the
# natural-language seat search uses it, and the app runs fine without it.
OLLAMA_HOST=
